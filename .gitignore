*.tfstate
*.tfstate.*
.terraform.lock.hcl
crash.log
*.tfvars
!example.tfvars

# Node
node_modules/

# Local
.DS_Store
*.log

# Real config values — only *.example.* templates are committed
terraform.tfvars
values.yaml
